<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form with Navbar and Footer</title>
    <link rel="stylesheet" href="/styles/navbar.css">
      <link rel="stylesheet" href="/styles/footer.css">
 <style> *{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f5f5f5;
    color:#333;
}

.container{
    width:100%;
    max-width:500px;
    margin:60px auto;
    padding:20px;
}

.container h2{
    text-align:center;
    color:#c40000;
    font-size:32px;
    margin-bottom:10px;
}

.container p{
    text-align:center;
    color:#666;
    margin-bottom:25px;
    font-size:15px;
    line-height:1.6;
}

form{
    background:#fff;
    padding:30px;
    border-radius:12px;
    box-shadow:0 8px 20px rgba(0,0,0,.08);
}

label{
    display:block;
    margin:15px 0 8px;
    font-weight:bold;
    color:#444;
}

input[type="text"],
textarea,
input[type="file"]{
    width:100%;
    padding:12px;
    border:1px solid #ddd;
    border-radius:8px;
    outline:none;
    font-size:15px;
    transition:.3s;
}

input[type="text"]:focus,
textarea:focus,
input[type="file"]:focus{
    border-color:#c40000;
    box-shadow:0 0 5px rgba(196,0,0,.2);
}

textarea{
    resize:vertical;
    min-height:120px;
}

input[type="submit"]{
    width:100%;
    margin-top:25px;
    padding:13px;
    background:#c40000;
    color:#fff;
    border:none;
    border-radius:8px;
    font-size:16px;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
}

input[type="submit"]:hover{
    background:#990000;
}
</style>
</head>
<body>


<%- include("navbar") %>

<div class="container">

    <h2>Add New Blog</h2>

    <p>
        Submit the information below to publish a new blog on our platform.
        Fill in the title, subtitle, description, and upload an image.
    </p>

    <form action="/addblog" method="post" enctype="multipart/form-data">

        <label>Title</label>
        <input type="text" name="title" required>

        <label>Subtitle</label>
        <input type="text" name="subtitle" required>

        <label>Description</label>
        <textarea name="description"></textarea>

        <label>Blog Image</label>
        <input type="file" name="image" required>

        <input type="submit" value="Publish Blog">

    </form>

</div>

<%- include("footer") %>
</body>
</html>
