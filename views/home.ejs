<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="refresh" content=""0.5>
    <title>Simple Layout with Cards</title>
   <link rel="stylesheet" href="styles/home.css">
      <link rel="stylesheet" href="styles/navbar.css">
        <link rel="stylesheet" href="/styles/footer.css">
</head>
<body>
<%- include("navbar") %>
   
<section>
    <!-- Body Section with Cards -->
   <section>
    <div class="container">
        <% blogs.forEach((blog)=>{ %>

      <div class="card">

    <img src="<%- blog.imageUrl %>" alt="blog image">

    <div class="card-body">
        <h2><%- blog.title %></h2>

        <h4><%- blog.subTitle %></h4>

        <p><%- blog.description %></p>

        <p>Author: <%- blog.user.username %></p>

        <a href="/blog/<%- blog.id %>">See more</a>
    </div>

</div>

        <% }) %>
    </div>
</section>
    </section>
<%- include("footer") %>
    <!-- Footer -->
   

</body>
</html>
