
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us</title>
 <link rel="stylesheet" href="/styles/navbar.css">
  <link rel="stylesheet" href="/styles/footer.css">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, Helvetica, sans-serif;
        }

        body{
            background:#f8f8f8;
            color:#333;
        }

       

        .hero{
            background:linear-gradient(rgba(160,0,0,.82),rgba(0,0,0,.75)),
            url("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1500&q=80");
            background-size:cover;
            background-position:center;
            color:white;
            text-align:center;
            padding:120px 20px;
        }

        .hero h1{
            font-size:55px;
            margin-bottom:20px;
        }

        .hero p{
            font-size:20px;
            max-width:750px;
            margin:auto;
            line-height:1.7;
        }

    

        .about{
            background:white;
            padding:70px 10%;
            text-align:center;
        }

        .about h2{
            color:#b30000;
            margin-bottom:25px;
            font-size:35px;
        }

        .about p{
            font-size:18px;
            line-height:1.9;
            color:#555;
        }

      

        .section-title{
            text-align:center;
            color:#b30000;
            margin-bottom:50px;
            font-size:35px;
        }

     

        .services{
            padding:70px 8%;
            background:#f3f3f3;
        }

        .service-container{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
            gap:25px;
        }

        .service-card{
            background:white;
            padding:30px;
            border-radius:12px;
            text-align:center;
            box-shadow:0 5px 15px rgba(0,0,0,.08);
            transition:.3s;
        }

        .service-card:hover{
            transform:translateY(-8px);
        }

        .service-card h3{
            color:#b30000;
            margin-bottom:15px;
        }

        .service-card p{
            line-height:1.7;
            color:#666;
        }

      

        .team{
            padding:70px 8%;
            background:white;
        }

        .team-container{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
            gap:30px;
        }

        .team-card{
            background:#fff;
            border-radius:12px;
            text-align:center;
            padding:30px;
            box-shadow:0 5px 18px rgba(0,0,0,.08);
            transition:.3s;
        }

        .team-card:hover{
            transform:translateY(-10px);
        }

        .team-card img{
            width:130px;
            height:130px;
            border-radius:50%;
            border:5px solid #b30000;
            margin-bottom:18px;
        }

        .team-card h3{
            color:#b30000;
            margin-bottom:8px;
        }

        .designation{
            color:#777;
            font-weight:bold;
            margin-bottom:15px;
        }

        .team-card p{
            color:#666;
            line-height:1.6;
        }

     

        .why{
            background:#f3f3f3;
            padding:70px 8%;
        }

        .why-container{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
            gap:25px;
        }

        .why-card{
            background:white;
            padding:25px;
            text-align:center;
            border-radius:12px;
            box-shadow:0 5px 15px rgba(0,0,0,.08);
        }

        .why-card h3{
            color:#b30000;
            margin-bottom:15px;
        }

        .why-card p{
            color:#666;
            line-height:1.7;
        }

      

        .mission{
            background:#b30000;
            color:white;
            text-align:center;
            padding:80px 10%;
        }

        .mission h2{
            margin-bottom:20px;
            font-size:35px;
        }

        .mission p{
            max-width:850px;
            margin:auto;
            line-height:1.8;
            font-size:18px;
        }

    </style>

</head>

